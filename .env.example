# Скопируйте в .env при необходимости. Файл .env не попадает в репозиторий, агент его не читает.
# Самому «Стратегу» ключи не нужны: модель и веб-поиск даёт ваша среда (Claude Code, Cursor, Codex и др.).

# Необязательно: проект по умолчанию вместо projects/.active
# STRATEG_PROJECT=demo-shield

# Необязательно: внешний классификатор подзадач. Получает на stdin JSON
#   {"state": "<текст подзадачи>", "choice": {"instructions": "...", "criteria": {"<класс>": "<описание>"}}}
# и печатает JSON {"choice": "<класс>", "probabilities": {...}, "confidence": 0.0-1.0}.
# Проверить без сети: STRATEG_ROUTER_CMD=python tools/router_stub.py
# STRATEG_ROUTER_CMD=python my_router.py

# Необязательно: адаптер Jev через AI/ML API (см. tools/router_jev.py; с настоящим сервисом не проверялся)
# JEV_API_KEY=
# STRATEG_ROUTER_CMD=python tools/router_jev.py

# Необязательно: векторный поиск по смыслу через локальный Ollama (ollama pull bge-m3)
# STRATEG_EMBED_MODEL=bge-m3

# Необязательно: режим разработки самого агента (разрешает править правила и инструменты без подтверждения)
# STRATEG_MAINTAINER=1
